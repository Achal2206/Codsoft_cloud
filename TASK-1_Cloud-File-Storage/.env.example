# Server Port
PORT=5001

# Storage Provider Preference (supabase | local)
STORAGE_PROVIDER=supabase

# =========================================================================
# ⚡ SUPABASE CLOUD STORAGE CONFIGURATION
# =========================================================================
# Step 1: Go to your Supabase Project Dashboard -> Project Settings -> API Keys
# Step 2: Copy your Project URL and service_role secret key (or anon key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key-here

# Step 3: Go to Storage in Supabase Dashboard and create a bucket (e.g. "codsoft-files")
# Make sure public access or appropriate RLS policies are enabled
SUPABASE_BUCKET=codsoft-files
